{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solidprivacy.nl/schemas/fact_extraction_request.schema.json",
  "title": "SolidPrivacy Fact Extraction Request",
  "type": "object",
  "required": ["id","case_id","task","jurisdiction","input_type","content","evidence","privacy_context","requested_provider","requested_model","prompt_version"],
  "properties": {
    "id": {"type":"string","minLength":1},
    "case_id": {"type":"string","minLength":1},
    "task": {"const":"extract_privacy_facts"},
    "jurisdiction": {"type":"array","items":{"type":"string"},"minItems":1,"uniqueItems":true},
    "input_type": {"type":"string","enum":["scrubbed_document","structured_data","mixed"]},
    "content": {},
    "evidence": {"type":"array","items":{"$ref":"evidence.schema.json"},"minItems":1},
    "privacy_context": {
      "type":"object",
      "required":["scrubbed","scrub_key_present","content_classification"],
      "properties": {
        "scrubbed":{"type":"boolean"},
        "scrub_key_present":{"type":"boolean"},
        "contains_direct_identifiers":{"type":["boolean","null"]},
        "content_classification":{"type":"string","enum":["public","internal","scrubbed_personal_data","personal_data","special_category"]}
      },
      "additionalProperties":false
    },
    "requested_provider":{"type":"string","minLength":1},
    "requested_model":{"type":"string","minLength":1},
    "prompt_version":{"type":"string","minLength":1}
  },
  "additionalProperties":false
}
