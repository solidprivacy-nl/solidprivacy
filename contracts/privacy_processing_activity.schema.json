{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solidprivacy.nl/schemas/privacy_processing_activity.schema.json",
  "title": "SolidPrivacy Canonical Privacy Processing Activity",
  "type": "object",
  "required": ["id", "name", "purposes", "personal_data", "data_subjects", "parties", "legal_bases", "retention"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": ["string", "null"]},
    "purposes": {"type": "array", "items": {"$ref": "#/$defs/purpose"}},
    "personal_data": {"type": "array", "items": {"$ref": "#/$defs/personalData"}},
    "data_subjects": {"type": "array", "items": {"$ref": "#/$defs/dataSubjectCategory"}},
    "parties": {"type": "array", "items": {"$ref": "#/$defs/party"}},
    "processing_operations": {"type": "array", "items": {"type": "string"}},
    "technologies": {"type": "array", "items": {"type": "string"}},
    "locations": {"type": "array", "items": {"$ref": "#/$defs/location"}},
    "transfers": {"type": "array", "items": {"$ref": "#/$defs/transfer"}},
    "legal_bases": {"type": "array", "items": {"$ref": "#/$defs/legalBasis"}},
    "retention": {"type": "array", "items": {"$ref": "#/$defs/retention"}},
    "rights_procedures": {"type": "array", "items": {"$ref": "#/$defs/rightProcedure"}},
    "source_references": {"type": "array", "items": {"$ref": "source_reference.schema.json"}}
  },
  "$defs": {
    "purpose": {
      "type": "object",
      "required": ["id", "description"],
      "properties": {
        "id": {"type": "string"},
        "description": {"type": "string"}
      },
      "additionalProperties": false
    },
    "personalData": {
      "type": "object",
      "required": ["id", "name", "category", "sensitivity", "data_subject_ids"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "category": {"type": "string"},
        "sensitivity": {"type": "string", "enum": ["ordinary", "sensitive_context", "special_category", "criminal", "national_identifier"]},
        "data_subject_ids": {"type": "array", "items": {"type": "string"}},
        "original_purpose": {"type": ["string", "null"]},
        "source": {"type": ["string", "null"]},
        "source_party": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "dataSubjectCategory": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "vulnerable": {"type": ["boolean", "null"]},
        "vulnerability_context": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "party": {
      "type": "object",
      "required": ["id", "name", "roles"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "roles": {"type": "array", "items": {"type": "string", "enum": ["controller", "joint_controller", "processor", "subprocessor", "recipient", "third_party", "provider"]}},
        "functions_or_departments": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "required": ["country"],
      "properties": {
        "country": {"type": "string"},
        "eea": {"type": ["boolean", "null"]}
      },
      "additionalProperties": false
    },
    "transfer": {
      "type": "object",
      "required": ["destination", "mechanism"],
      "properties": {
        "destination": {"type": "string"},
        "mechanism": {"type": "string", "enum": ["adequacy", "scc", "bcr", "certification", "code_of_conduct", "binding_instrument", "article_49_derogation", "other"]},
        "supplementary_measures": {"type": "array", "items": {"type": "string"}},
        "requires_transfer_assessment": {"type": ["boolean", "null"]}
      },
      "additionalProperties": false
    },
    "legalBasis": {
      "type": "object",
      "required": ["basis", "rationale"],
      "properties": {
        "basis": {"type": "string", "enum": ["consent", "contract", "legal_obligation", "vital_interests", "public_task", "legitimate_interests", "other"]},
        "rationale": {"type": "string"},
        "legal_reference": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "required": ["period", "rationale"],
      "properties": {
        "purpose_ids": {"type": "array", "items": {"type": "string"}},
        "data_subject_ids": {"type": "array", "items": {"type": "string"}},
        "personal_data_ids": {"type": "array", "items": {"type": "string"}},
        "period": {"type": "string"},
        "rationale": {"type": "string"},
        "owner": {"type": ["string", "null"]},
        "end_action": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "rightProcedure": {
      "type": "object",
      "required": ["right", "procedure_status"],
      "properties": {
        "right": {"type": "string", "enum": ["access", "rectification", "erasure", "restriction", "portability", "automated_decision_making", "objection", "information"]},
        "procedure_status": {"type": "string", "enum": ["implemented", "not_implemented", "not_applicable", "unknown"]},
        "procedure": {"type": ["string", "null"]},
        "restriction_basis": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
