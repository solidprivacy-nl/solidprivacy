{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solidprivacy.nl/schemas/dpia_assessment.schema.json",
  "title": "SolidPrivacy Canonical DPIA Assessment",
  "type": "object",
  "required": ["id", "title", "jurisdiction", "methodology", "processing_activities", "necessity_proportionality", "risks", "measures", "residual_risk_conclusion", "human_review"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["draft", "review", "final"]},
    "jurisdiction": {"type": "array", "items": {"type": "string"}},
    "methodology": {
      "type": "object",
      "required": ["id", "version", "source_refs"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"},
        "source_refs": {"type": "array", "items": {"$ref": "source_reference.schema.json"}}
      },
      "additionalProperties": false
    },
    "proposal": {"type": ["string", "null"]},
    "processing_activities": {"type": "array", "minItems": 1, "items": {"$ref": "privacy_processing_activity.schema.json"}},
    "legal_policy_context": {"type": "array", "items": {"type": "string"}},
    "necessity_proportionality": {
      "type": "object",
      "required": ["assessment"],
      "properties": {
        "assessment": {"type": "string"},
        "less_intrusive_alternatives": {"type": "array", "items": {"type": "string"}},
        "data_minimisation": {"type": ["string", "null"]},
        "balancing_or_public_interest_reasoning": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "special_data_assessment": {"type": "array", "items": {"$ref": "#/$defs/specialDataAssessment"}},
    "purpose_compatibility": {"type": "array", "items": {"$ref": "#/$defs/purposeCompatibility"}},
    "risks": {"type": "array", "items": {"$ref": "#/$defs/risk"}},
    "measures": {"type": "array", "items": {"$ref": "#/$defs/measure"}},
    "residual_risk_conclusion": {
      "type": "object",
      "required": ["level", "rationale", "prior_consultation_required"],
      "properties": {
        "level": {"type": "string", "enum": ["low", "medium", "high", "unknown"]},
        "rationale": {"type": "string"},
        "prior_consultation_required": {"type": ["boolean", "null"]},
        "prior_consultation_reference": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "dpo_advice": {"type": ["string", "null"]},
    "management_summary": {"type": ["string", "null"]},
    "evidence": {"type": "array", "items": {"$ref": "evidence.schema.json"}},
    "legal_claims": {"type": "array", "items": {"$ref": "legal_claim.schema.json"}},
    "human_review": {"$ref": "human_review.schema.json"},
    "source_versions": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "specialDataAssessment": {
      "type": "object",
      "required": ["data_type", "exception_or_authorisation"],
      "properties": {
        "processing_activity_ids": {"type": "array", "items": {"type": "string"}},
        "personal_data_ids": {"type": "array", "items": {"type": "string"}},
        "data_subject_ids": {"type": "array", "items": {"type": "string"}},
        "data_type": {"type": "string"},
        "exception_or_authorisation": {"type": "string"},
        "legal_reference": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "purposeCompatibility": {
      "type": "object",
      "required": ["processing_activity_id", "decision", "rationale"],
      "properties": {
        "processing_activity_id": {"type": "string"},
        "decision": {"type": "string", "enum": ["same_purpose", "compatible", "authorised_by_law", "not_compatible", "unknown"]},
        "rationale": {"type": "string"}
      },
      "additionalProperties": false
    },
    "risk": {
      "type": "object",
      "required": ["id", "description", "origin", "likelihood", "impact", "inherent_level", "rationale"],
      "properties": {
        "id": {"type": "string"},
        "processing_activity_ids": {"type": "array", "items": {"type": "string"}},
        "description": {"type": "string"},
        "origin": {"type": "string"},
        "likelihood": {"type": "string", "enum": ["low", "medium", "high", "unknown"]},
        "impact": {"type": "string", "enum": ["low", "medium", "high", "unknown"]},
        "inherent_level": {"type": "string", "enum": ["low", "medium", "high", "unknown"]},
        "rationale": {"type": "string"},
        "affected_rights": {"type": "array", "items": {"type": "string"}},
        "affected_data_subjects": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "measure": {
      "type": "object",
      "required": ["id", "description", "risk_ids", "measure_types", "owner", "implementation_status", "residual_level"],
      "properties": {
        "id": {"type": "string"},
        "description": {"type": "string"},
        "risk_ids": {"type": "array", "items": {"type": "string"}},
        "measure_types": {"type": "array", "items": {"type": "string", "enum": ["technical", "organisational", "legal"]}},
        "owner": {"type": ["string", "null"]},
        "implementation_status": {"type": "string", "enum": ["planned", "partial", "implemented", "verified", "not_started"]},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "residual_level": {"type": "string", "enum": ["low", "medium", "high", "unknown"]},
        "residual_rationale": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
