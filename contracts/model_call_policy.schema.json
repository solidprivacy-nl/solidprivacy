{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solidprivacy.nl/schemas/model_call_policy.schema.json",
  "title": "SolidPrivacy Model Call Policy",
  "type": "object",
  "required": ["id","approved","execution_mode","provider","model","allowed_tasks","require_scrubbed","max_content_classification","allow_scrubbed_personal_data_egress","allow_personal_data_egress","allow_special_category_egress","provider_training_use","provider_retention","logging_policy"],
  "properties": {
    "id": {"type":"string","minLength":1},
    "approved": {"type":"boolean"},
    "execution_mode": {"type":"string","enum":["local","external"]},
    "provider": {"type":"string","minLength":1},
    "model": {"type":"string","minLength":1},
    "allowed_tasks": {"type":"array","items":{"type":"string","enum":["extract_privacy_facts"]},"minItems":1,"uniqueItems":true},
    "require_scrubbed": {"type":"boolean"},
    "max_content_classification": {"type":"string","enum":["public","internal","scrubbed_personal_data","personal_data","special_category"]},
    "allow_scrubbed_personal_data_egress": {"type":"boolean"},
    "allow_personal_data_egress": {"type":"boolean"},
    "allow_special_category_egress": {"type":"boolean"},
    "provider_training_use": {"type":"string","enum":["disabled","contractually_disabled","unknown","allowed"]},
    "provider_retention": {"type":"string","enum":["zero_or_transient","defined_limited","unknown","indefinite"]},
    "logging_policy": {"type":"string","enum":["no_content","metadata_only","content_allowed","unknown"]},
    "approved_by": {"type":["string","null"]},
    "approved_at": {"type":["string","null"],"format":"date-time"},
    "review_due": {"type":["string","null"],"format":"date"},
    "notes": {"type":["string","null"]}
  },
  "allOf": [{
    "if": {"properties":{"approved":{"const":true}},"required":["approved"]},
    "then": {"required":["approved_by","approved_at"],"properties":{"approved_by":{"type":"string","minLength":1},"approved_at":{"type":"string","format":"date-time"}}}
  }],
  "additionalProperties": false
}
