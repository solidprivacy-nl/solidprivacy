{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solidprivacy.nl/schemas/dpia_review_request.schema.json",
  "title": "SolidPrivacy DPIA Privacy Officer Review Request",
  "type": "object",
  "required": ["id", "case_id", "analysis_request", "analysis", "legal_context", "required_review_targets", "snapshot_hashes", "generated_at"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "analysis_request": {"$ref": "dpia_analysis_request.schema.json"},
    "analysis": {"$ref": "dpia_analysis_result.schema.json"},
    "legal_context": {"$ref": "legal_context_bundle.schema.json"},
    "required_review_targets": {
      "type": "array",
      "items": {"$ref": "#/$defs/reviewTarget"},
      "minItems": 1,
      "uniqueItems": true
    },
    "snapshot_hashes": {
      "type": "object",
      "required": ["analysis_request", "evidence_pack", "legal_context", "analysis"],
      "properties": {
        "analysis_request": {"$ref": "#/$defs/hash"},
        "evidence_pack": {"$ref": "#/$defs/hash"},
        "legal_context": {"$ref": "#/$defs/hash"},
        "analysis": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": false
    },
    "generated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reviewTarget": {
      "type": "object",
      "required": ["target_type", "target_id"],
      "properties": {
        "target_type": {"type": "string", "enum": ["fact", "claim", "risk", "measure", "section"]},
        "target_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
