{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solidprivacy.nl/schemas/legal_claim.schema.json",
  "title": "SolidPrivacy Legal Claim",
  "type": "object",
  "required": ["claim", "classification", "jurisdiction", "authority", "source_id", "verified_at"],
  "properties": {
    "claim": {"type": "string", "minLength": 1},
    "classification": {"type": "string", "enum": ["LAW_REQUIRED", "REGULATOR_GUIDANCE", "ORGANISATION_POLICY", "BEST_PRACTICE", "ASSUMPTION"]},
    "jurisdiction": {"type": "string", "minLength": 1},
    "authority": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "citation": {"type": ["string", "null"]},
    "effective_date": {"type": ["string", "null"], "format": "date"},
    "verified_at": {"type": "string", "format": "date-time"},
    "supersedes": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
